# Local development database. The file is ignored by Git.
MOVEBOOK_DATABASE_URL=sqlite:///./movebook_dev.db

# Future PostgreSQL deployment example:
# MOVEBOOK_DATABASE_URL=postgresql+psycopg://movebook:replace_me@127.0.0.1:5432/movebook

MOVEBOOK_APP_NAME=MK3 MoveBook Server
MOVEBOOK_SQL_ECHO=false

# Public URLs used by the browser-based login flow.
MOVEBOOK_PUBLIC_BASE_URL=http://127.0.0.1:8010
MOVEBOOK_DISCORD_REDIRECT_URI=http://127.0.0.1:8010/api/v1/auth/discord/callback

# Replace locally; never commit real provider credentials or signing secrets.
MOVEBOOK_DISCORD_CLIENT_ID=replace_with_discord_client_id
MOVEBOOK_DISCORD_CLIENT_SECRET=replace_with_discord_client_secret
MOVEBOOK_JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

MOVEBOOK_ACCESS_TTL_MIN=15
MOVEBOOK_REFRESH_TTL_DAYS=30
MOVEBOOK_LOGIN_TTL_SECONDS=300
MOVEBOOK_LOGIN_POLL_INTERVAL_SECONDS=2
