MOVEBOOK_DATABASE_URL=sqlite:////var/lib/movebook-server/movebook.db
MOVEBOOK_APP_NAME=MK3 MoveBook Server
MOVEBOOK_SQL_ECHO=false

MOVEBOOK_PUBLIC_BASE_URL=https://api.movebook.ru
MOVEBOOK_DISCORD_REDIRECT_URI=https://api.movebook.ru/api/v1/auth/discord/callback

MOVEBOOK_DISCORD_CLIENT_ID=replace_with_discord_client_id
MOVEBOOK_DISCORD_CLIENT_SECRET=replace_with_discord_client_secret
MOVEBOOK_JWT_SECRET=replace_with_a_new_random_production_secret

MOVEBOOK_ACCESS_TTL_MIN=15
MOVEBOOK_REFRESH_TTL_DAYS=30
MOVEBOOK_LOGIN_TTL_SECONDS=300
MOVEBOOK_LOGIN_POLL_INTERVAL_SECONDS=2
